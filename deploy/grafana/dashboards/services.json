            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "circuit_breaker_state",
          "instant": true,
          "legendFormat": "{{job}} · {{name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Circuit breakers",
      "description": "Open: calls to the dependency are suspended and fail fast.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
