{
  "uid": "orderflow-messaging",
  "title": "OrderFlow - Messaging",
  "description": "Consumers, retries, dead letter queues, RabbitMQ queue depth, and the transactional outbox.",
  "tags": [
    "orderflow"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
