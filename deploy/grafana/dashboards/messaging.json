{
  "uid": "orderflow-messaging",
  "title": "OrderFlow - Messaging",
  "description": "Consumers, retries, dead letter queues, RabbitMQ queue depth, and the transactional outbox.",
  "tags": [
    "orderflow"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Business",
      "type": "link",
      "url": "/d/orderflow-business",
