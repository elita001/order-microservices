# Local development settings for docker compose.
# Copy to .env (`make up` does it automatically) and adjust if needed.
# Never commit .env and never put production secrets here: in production
# they come from the platform (Kubernetes Secrets, Vault, CI/CD variables).

# PostgreSQL. The password is inserted into a DSN, so avoid URL-reserved
# characters (@ : / ? # %) or URL-encode them.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=orderflow

# Redis (rate limits and idempotency keys in the API gateway).
REDIS_PASSWORD=app

# RabbitMQ (also used for the management UI login).
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# Host ports. Change them if they are already taken on your machine.
GATEWAY_HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
ORDER_HTTP_PORT=8081
PAYMENT_HTTP_PORT=8082
DELIVERY_HTTP_PORT=8083
NOTIFICATION_HTTP_PORT=8084
MAILPIT_UI_PORT=8025

# debug, info, warn, error
LOG_LEVEL=debug

# Payment provider stub: share of declined payments (0..1) and response delay.
PAYMENT_STUB_FAILURE_RATE=0.2
# Share of calls failing with a technical error; set to 1 to simulate a provider outage
# (the circuit breaker opens, messages are retried and finally dead-lettered).
PAYMENT_STUB_ERROR_RATE=0
PAYMENT_STUB_MIN_DELAY=100ms
PAYMENT_STUB_MAX_DELAY=1s

# Delivery (carrier) stub: share of calls failing with a technical error (0..1),
# which the consumer retries, and response delay.
DELIVERY_STUB_ERROR_RATE=0.1
DELIVERY_STUB_MIN_DELAY=100ms
DELIVERY_STUB_MAX_DELAY=500ms

# API gateway rate limits per client IP: requests per second and burst size.
RATE_LIMIT_READ_RPS=50
RATE_LIMIT_READ_BURST=100
RATE_LIMIT_WRITE_RPS=5
RATE_LIMIT_WRITE_BURST=10

# How long an order stays in the Redis cache (status changes invalidate it earlier).
ORDER_CACHE_TTL=5m

# Pauses before each retry of a failed event; after the last one the event goes to the
# service's dead letter queue (<service>-service.dlq). See `make dlq-list`.
CONSUMER_RETRY_DELAYS=1s,5s,30s,2m,10m
