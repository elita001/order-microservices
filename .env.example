# Local development settings for docker compose.
# Copy to .env (`make up` does it automatically) and adjust if needed.
# Never commit .env and never put production secrets here: in production
# they come from the platform (Kubernetes Secrets, Vault, CI/CD variables).

# PostgreSQL. The password is inserted into a DSN, so avoid URL-reserved
# characters (@ : / ? # %) or URL-encode them.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=orderflow

# Redis (rate limits and idempotency keys in the API gateway).
REDIS_PASSWORD=app

# Keycloak admin console (http://localhost:8180, user "admin"). Test users of the
# "orderflow" realm: alice/alice and bob/bob (customers), support/support (sees all orders).
KEYCLOAK_ADMIN_PASSWORD=admin
# Secrets of the services' own Keycloak clients (client credentials grant): the
# notification service reads customer profiles, the customer service reads Keycloak users.
NOTIFICATION_CLIENT_SECRET=dev-notification-secret-4c1e9a7b
CUSTOMER_CLIENT_SECRET=dev-customer-secret-8f2d6b3a

# Grafana admin password (dashboards are also viewable without logging in).
GRAFANA_ADMIN_PASSWORD=admin

# GlitchTip (error tracking, http://localhost:8000). The admin user and the project with
# this DSN key are created on first start. Development values only.
GLITCHTIP_ADMIN_EMAIL=admin@orderflow.local
GLITCHTIP_ADMIN_PASSWORD=orderflow-admin
GLITCHTIP_SECRET_KEY=dev-only-change-me-6f1c2a9e8b7d4c3f
GLITCHTIP_DSN_KEY=3f2b8c1d9e4a4b6f8a7c5d2e1f0a9b8c
# Uncomment to send errors to sentry.io (or another server) instead of local GlitchTip.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>

# RabbitMQ (also used for the management UI login).
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# Host ports. Change them if they are already taken on your machine.
GATEWAY_HTTP_PORT=8080
KEYCLOAK_PORT=8180
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
ORDER_GRPC_PORT=9081
ORDER_HTTP_PORT=8081
CUSTOMER_GRPC_PORT=9085
CUSTOMER_HTTP_PORT=8085
PAYMENT_HTTP_PORT=8082
DELIVERY_HTTP_PORT=8083
NOTIFICATION_HTTP_PORT=8084
MAILPIT_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_UI_PORT=12345
GLITCHTIP_PORT=8000

# debug, info, warn, error
LOG_LEVEL=debug

# Payment provider stub: share of declined payments (0..1) and response delay.
PAYMENT_STUB_FAILURE_RATE=0.2
# Share of calls failing with a technical error; set to 1 to simulate a provider outage
# (the circuit breaker opens, messages are retried and finally dead-lettered).
PAYMENT_STUB_ERROR_RATE=0
PAYMENT_STUB_MIN_DELAY=100ms
PAYMENT_STUB_MAX_DELAY=1s

# Delivery (carrier) stub: share of calls failing with a technical error (0..1),
# which the consumer retries, and response delay.
DELIVERY_STUB_ERROR_RATE=0.1
DELIVERY_STUB_MIN_DELAY=100ms
DELIVERY_STUB_MAX_DELAY=500ms

# API gateway rate limits per user: requests per second and burst size.
RATE_LIMIT_READ_RPS=50
RATE_LIMIT_READ_BURST=100
RATE_LIMIT_WRITE_RPS=5
RATE_LIMIT_WRITE_BURST=10

# How long the customer service serves its copy of a Keycloak user before refreshing it.
CUSTOMER_PROFILE_REFRESH_AFTER=1h

# How long an order stays in the Redis cache (status changes invalidate it earlier).
ORDER_CACHE_TTL=5m

# Pauses before each retry of a failed event; after the last one the event goes to the
# service's dead letter queue (<service>-service.dlq). See `make dlq-list`.
CONSUMER_RETRY_DELAYS=1s,5s,30s,2m,10m
